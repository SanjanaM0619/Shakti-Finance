{
  "name": "shakti-finance-mern",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Shakti Finance (MERN Stack) — Integrated Financial Management, Intelligence & Government Support Platform for Women Entrepreneurs",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch backend/index.js",
    "dev:frontend": "vite --config frontend/vite.config.ts frontend",
    "build": "vite build --config frontend/vite.config.ts frontend",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "start": "node backend/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
